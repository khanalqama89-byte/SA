{
  "version": 2,
  "buildCommand": "cd frontend/sa-web && npm install && npm run build",
  "outputDirectory": "frontend/sa-web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
