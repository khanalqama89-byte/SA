# ======================================================================
# SA Document Converter Platform - Environment Variables
# Copy this file to .env and adjust values for your environment
# ======================================================================

# Server Port
SERVER_PORT=8080

# Spring Profiles: dev or prod
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/sa_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JWT Authentication Secret (Must be at least 256 bits / 32 characters long)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Storage Configuration (Absolute or relative path to SA storage directory)
STORAGE_BASE_PATH=../../storage
STORAGE_MAX_FILE_SIZE=52428800
STORAGE_FILE_EXPIRY_HOURS=24

# CORS / Frontend URL
FRONTEND_URL=http://localhost:3000

# Headless Office Conversion (LibreOffice executable path)
# Linux: /usr/bin/libreoffice or /usr/bin/soffice
# macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Windows: C:/Program Files/LibreOffice/program/soffice.exe
LIBREOFFICE_PATH=soffice

# Async Worker Pool
CONVERSION_CORE_POOL_SIZE=4
CONVERSION_MAX_POOL_SIZE=8
CONVERSION_QUEUE_CAPACITY=100
